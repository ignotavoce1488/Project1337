ENVIRONMENT=production
DOMAIN=https://notes.example.com
BOT_TOKEN=
GEMINI_API_KEYS=
GEMINI_MODELS=gemini-2.5-flash
# Optional OpenRouter fallback configuration; comma-separated model IDs.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=
# Administrative access is disabled unless both values are configured.
ADMIN_USER_ID=0
ADMIN_SECRET=
# Public Telegram API download limit. Raise only with a separately managed local Bot API.
MAX_UPLOAD_BYTES=20971520
MAX_AUDIO_SECONDS=10800
MAX_PENDING_JOBS=100
MAX_USER_JOBS=3
JOB_TIMEOUT_SECONDS=1800
AUTH_MAX_AGE=3600
TELEGRAM_API_URL=
YOUTUBE_PROXY=
# Only for a separately managed Bot API running in --local mode:
# TELEGRAM_LOCAL_FILE_ROOT=/var/lib/telegram-bot-api
STORAGE_GROUP_WRITABLE=false
